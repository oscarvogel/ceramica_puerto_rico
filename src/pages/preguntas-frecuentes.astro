---
/**
 * Preguntas frecuentes — SPEC §20.
 * Incluye FAQPage JSON-LD para SEO.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { faq } from '../data/faq';

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Preguntas frecuentes', url: '/preguntas-frecuentes' },
];

const faqJsonLd = faq.map((f) => ({ q: f.q, a: f.a }));
---

<BaseLayout
  title="Preguntas Frecuentes | Cerámica Puerto Rico"
  description="Respuestas a las preguntas más frecuentes sobre ladrillos cerámicos Cerámica Puerto Rico: elección, rendimiento, almacenamiento, presupuestos y entregas."
  path="/preguntas-frecuentes"
  breadcrumbs={breadcrumbs}
  faqJsonLd={faqJsonLd}
>
  <section class="page-hero">
    <div class="container">
      <span class="section-eyebrow">Preguntas frecuentes</span>
      <h1>Resolvemos tus dudas</h1>
      <p class="page-hero-sub">
        Si no encontrás la respuesta que buscás, escribinos por WhatsApp.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container faq-container">
      {faq.map((item) => (
        <details class="faq-item" name="faq">
          <summary aria-expanded="false">
            <span class="faq-q">{item.q}</span>
            <span class="faq-toggle" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <line class="h-line" x1="5" y1="12" x2="19" y2="12"/>
                <line class="v-line" x1="12" y1="5" x2="12" y2="19"/>
              </svg>
            </span>
          </summary>
          <div class="faq-content">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </section>

  <section class="section section--tight section--dark cta">
    <div class="container cta-block">
      <h2>¿Tenés otra pregunta?</h2>
      <a href="/contacto" class="btn btn-primary">Escribinos</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: var(--color-terracota-50);
    padding-block: var(--space-8);
  }
  .page-hero h1 { font-size: clamp(2rem, 4vw, 3rem); margin-bottom: var(--space-3); }
  .page-hero-sub { color: var(--color-grafito-500); margin: 0; }

  .faq-container {
    max-width: 800px;
  }
  .faq-item {
    border-bottom: 1px solid var(--color-grafito-100);
    padding: var(--space-4) 0;
  }
  .faq-item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    cursor: pointer;
    font-size: var(--fs-300);
    font-weight: 600;
    color: var(--color-grafito-900);
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:hover { color: var(--color-terracota-600); }
  .faq-item summary:focus-visible {
    outline: 2px solid var(--color-terracota-500);
    outline-offset: 4px;
    border-radius: 4px;
  }
  .faq-q { flex: 1; }
  .faq-toggle {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-terracota-50);
    color: var(--color-terracota-600);
    transition: background var(--t-fast);
  }
  .faq-item summary:hover .faq-toggle {
    background: var(--color-terracota-100);
  }
  .faq-toggle .v-line {
    transition: transform 0.3s ease, opacity 0.2s ease;
    transform-origin: center;
  }
  .faq-item[open] .faq-toggle .v-line {
    transform: rotate(90deg);
    opacity: 0;
  }
  .faq-item[open] summary { margin-bottom: var(--space-3); }
  .faq-content {
    animation: faq-fade-in 0.3s ease;
  }
  @keyframes faq-fade-in {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: none; }
  }
  .faq-item p { color: var(--color-grafito-500); margin: 0 0 var(--space-3); }

  .cta-block {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }
  .cta-block h2 { color: var(--color-blanco); margin: 0; }
</style>
