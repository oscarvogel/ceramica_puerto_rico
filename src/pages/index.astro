  .featured-cta-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* Las 4 líneas de producto: la navegación interna del catálogo. */
  .featured-lines {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: var(--space-3) 0 0;
    border-top: 1px solid rgba(245, 241, 236, 0.16);
    display: grid;
  }
  .featured-lines a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 0.45rem 0;
    color: var(--on-dark);
    border-bottom: 1px solid transparent;
    transition: color var(--t-fast), border-color var(--t-fast);
  }
  .featured-lines a:hover {
    color: var(--accent);
    text-decoration: none;
    border-bottom-color: rgba(245, 241, 236, 0.22);
  }
  .featured-line-name { font-weight: 600; font-size: var(--fs-100); }
  .featured-line-count { font-size: var(--fs-50); color: var(--on-dark-muted); }
  .featured-cta-label {
    font-size: var(--fs-50);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
