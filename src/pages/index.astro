  .featured-cta-link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.4rem;
    margin-top: var(--space-3);
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--accent-on-dark);
    border-radius: 999px;
