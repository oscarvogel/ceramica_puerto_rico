---
/**
 * Home — Cerámica Puerto Rico.
 *
 * Estructura (SPEC §22, revisada con el plan de mejora):
 *   hero · datos · selector de uso · catálogo bento · prueba de fábrica ·
 *   beneficios · recursos y preguntas · cotización
 *
 * Ritmo de superficies: anthracita → naranja → cal → cal → arena → cal →
 * arena → anthracita. La paleta no cambia; cambia la proporción.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard.astro';
import BrickCut from '../components/BrickCut.astro';
import PlantGallery from '../components/PlantGallery.astro';
import { company } from '../data/company';
import { getFeaturedProducts, productTypes, products } from '../data/products';
import { applications } from '../data/applications';
import { faq } from '../data/faq';

const featured = getFeaturedProducts();

/* Las 4 líneas de producto, con su cantidad real de modelos. */
const lineas = productTypes.map((t) => ({
  id: t.id,
  label: t.label,
  total: products.filter((p) => p.type === t.id).length,
}));

/* — Datos de la franja. Todos verificados contra la empresa. — */
const stats = [
  { value: 1975, label: 'Año de inicio', note: 'en Puerto Rico, Misiones' },
  { value: products.length, label: 'Modelos en catálogo', note: 'en 4 líneas de producto' },
  { value: 405, label: 'Unidades por palet', note: 'en el liviano 12×18×24' },
  { value: 4, label: 'Provincias con entrega', note: 'Misiones, Corrientes, Chaco y Formosa' },
];

/* — Propuesta de valor — */
const valueProps = [
  {
    icon: 'patented',
    title: 'Stock constante',
    points: ['Ladrillo hueco 12×18×24', 'Sin esperas de producción', 'Despacho inmediato'],
  },
  {
    icon: 'hydrophobic',
    title: 'Producción regional',
    points: ['Hecho en Misiones', 'Sin intermediarios', 'Precio de fábrica'],
  },
  {
    icon: 'invoicing',
    title: 'Atención personalizada',
    points: ['Un interlocutor siempre', 'Asesoramiento en obra', 'Respuesta rápida'],
  },
  {
    icon: 'logistics',
    title: 'Vos construís, nosotros lo llevamos',
    points: ['Camiones propios', 'Carga y descarga en obra', 'Acortamos el tiempo de obra'],
  },
];

/* — Beneficios (el corte del ladrillo los explica) — */
const benefits = [
  {
    icon: 'thermal',
    title: 'Aislación térmica y acústica',
    desc: 'Las celdas del ladrillo hueco forman cámaras de aire que ayudan a mantener una temperatura pareja dentro de la casa y reducen el paso de los ruidos molestos.',
  },
  {
    icon: 'capacity',
    title: 'Mayor velocidad de construcción',
    desc: 'Al ser más grandes y livianos que el ladrillo común, rinden más por metro cuadrado y se colocan con mayor rapidez.',
  },
  {
    icon: 'clay',
    title: 'Ahorro de material',
    desc: 'Requieren menor cantidad de mezcla para el pegado entre piezas.',
  },
  {
    icon: 'fire',
    title: 'Resistencia al fuego',
    desc: 'Son materiales seguros que no se prenden fuego y protegen de las llamas.',
  },
  {
    icon: 'conduit',
    title: 'Pasaje de instalaciones',
    desc: 'Sus celdas internas facilitan la realización de canales para los caños de luz, agua o gas.',
  },
];

/* — Prueba de fábrica: fotos reales de la planta — */
const plantPhotos = [
  {
    src: '/images/planta/horno-pallets-1.webp',
    alt: 'Ladrillos cerámicos apilados en el horno túnel de la planta, listos para la cocción',
    label: 'Horno túnel',
  },
  {
    src: '/images/planta/secado-estanterias.webp',
    alt: 'Ladrillos secando en las estanterías del secadero continuo de la planta',
    label: 'Secadero continuo',
  },
  {
    src: '/images/planta/pallets-exterior-1.webp',
    alt: 'Pallets de ladrillos enfardados con la identificación de Cerámica Puerto Rico, listos para despacho',
    label: 'Depósito y despacho',
  },
  {
    src: '/images/planta/taller-operarios.webp',
    alt: 'Dos operarios de la planta en el taller, junto al banco de trabajo',
    label: 'Taller de la planta',
  },
  {
    src: '/images/logistica/camion-carga.webp',
    alt: 'Camión de la empresa estacionado en la planta, listo para la carga',
    label: 'Flota propia',
  },
  {
    src: '/images/obras/ensayo-estructura.webp',
    alt: 'Pieza de encadenado en perfil de U sobre el terreno de la planta',
    label: 'Pieza de encadenado',
  },
];

/* — Preguntas frecuentes para el bloque de la home — */
const faqHome = faq.slice(0, 4);

const breadcrumbs = [{ name: 'Inicio', url: '/' }];

const waQuote = encodeURIComponent(
  'Hola, quiero pedir una cotización para mi obra.',
);
---

<BaseLayout
  title={`${company.name} | Ladrillos Cerámicos en Misiones`}
  description="Fábrica de ladrillos cerámicos huecos en Puerto Rico, Misiones. Conocé nuestros productos, información técnica, distribuidores y solicitá tu presupuesto."
  path="/"
  breadcrumbs={breadcrumbs}
>
  <Hero />

  <!-- Franja de datos -->
  <section class="stats-strip" aria-label="Datos de la empresa">
    <div class="container">
      <ul class="stats-list">
        {stats.map((s) => (
          <li class="stat">
            <span class="stat-value mono" data-count={s.value}>{s.value}</span>
            <span class="stat-label">{s.label}</span>
            <span class="stat-note">{s.note}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Selector: ¿qué necesitás construir? -->
  <section class="section section--tight">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="section-eyebrow">Por donde empezar</span>
          <h2>¿Qué necesitás construir?</h2>
          <p class="section-intro">
            Elegí el tipo de obra y te mostramos los ladrillos que le
            corresponden, con sus medidas y el rendimiento por pallet.
          </p>
        </div>
        <a href="/aplicaciones" class="section-head-aside">
          Ver todas las aplicaciones
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
               stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>

      <ul class="use-grid">
        {applications.map((a) => (
          <li>
            <a href={`/aplicaciones/${a.id}`} class="use-card">
              <span class="use-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
              <span class="use-title">{a.title}</span>
              <span class="use-desc">{a.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Propuesta de valor -->
  <section class="section section--tight value-section">
    <div class="container">
      <ul class="value-grid">
        {valueProps.map((v) => (
          <li class="card value-card">
            <span class="value-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor"
                   stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                {v.icon === 'patented' && <><rect x="4" y="4" width="16" height="16" rx="2" /><path d="M9 12l2 2 4-4" /></>}
                {v.icon === 'hydrophobic' && <><path d="M12 3s6 6.5 6 10.5A6 6 0 0 1 6 13.5C6 9.5 12 3 12 3z" /><path d="M9.5 14a2.5 2.5 0 0 0 2.5 2.5" /></>}
                {v.icon === 'invoicing' && <><path d="M6 3h9l4 4v14H6z" /><path d="M15 3v4h4M9 12h7M9 16h5" /></>}
                {v.icon === 'logistics' && <><path d="M3 7h11v9H3z" /><path d="M14 10h4l3 3v3h-7z" /><circle cx="7" cy="18" r="1.8" /><circle cx="17" cy="18" r="1.8" /></>}
              </svg>
            </span>
            <h3>{v.title}</h3>
            <ul class="value-points">
              {v.points.map((p) => (
                <li>
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor"
                       stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  {p}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Catálogo destacado: bento 3 × 3 -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="section-eyebrow">Catálogo de productos</span>
          <h2>Elegí el material que se ajuste a tu obra</h2>
          <p class="section-intro">
            Ladrillos huecos, portantes y piezas de encadenado. Compará
            medidas, peso y cantidad por pallet.
          </p>
        </div>
      </div>

      <div class="featured-grid">
        <div class="featured-cta">
          <span class="featured-cta-number" aria-hidden="true">{products.length}</span>

          <div class="featured-cta-bottom">
            <span class="featured-cta-label">Catálogo completo</span>
            <strong class="featured-cta-title">Livianos, portantes, vistos y encadenados</strong>
            <span class="featured-cta-text">
              Cada modelo con sus medidas, su peso unitario y la cantidad de
              ladrillos por pallet.
            </span>

            <ul class="featured-lines">
              {lineas.map((l) => (
                <li>
                  <a href={`/productos?type=${l.id}`}>
                    <span class="featured-line-name">{l.label}</span>
                    <span class="featured-line-count mono">{l.total} modelos</span>
                  </a>
                </li>
              ))}
            </ul>

            <a href="/productos" class="featured-cta-link">
              Ver los {products.length} modelos
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
                   stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </div>
        </div>

        {featured.map((p) => <ProductCard product={p} compact />)}
      </div>
    </div>
  </section>

  <!-- Prueba de fábrica -->
  <section class="section section--sand">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="section-eyebrow">De la arcilla a la obra</span>
          <h2>Esto es lo que hay en la planta</h2>
          <p class="section-intro">
            No son fotos de banco de imágenes: son nuestro horno, nuestro
            secadero, nuestro taller y nuestra flota.
          </p>
        </div>
        <a href="/historia-y-proceso" class="section-head-aside">
          Ver el proceso completo
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
               stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>

      <PlantGallery items={plantPhotos} />
    </div>
  </section>

  <!-- Beneficios: el corte del ladrillo los explica -->
  <section class="section">
    <div class="container benefits-layout">
      <div class="benefits-aside">
        <span class="section-eyebrow">Beneficios productivos</span>
        <h2>Ventajas de utilizar ladrillos cerámicos</h2>
        <BrickCut caption="Corte de un ladrillo hueco 12×18×24: seis celdas de 6×6 cm que atraviesan los 24 cm de largo." />
      </div>

      <ul class="benefits-list">
        {benefits.map((b) => (
          <li class="benefit-item">
            <span class="benefit-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor"
                   stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                {b.icon === 'thermal' && <><path d="M4 20V10l8-6 8 6v10" /><path d="M8 14a2 2 0 0 1 2-2 2 2 0 0 1 2 2 2 2 0 0 1 2-2 2 2 0 0 1 2 2" /><path d="M8 18a2 2 0 0 1 2-2 2 2 0 0 1 2 2 2 2 0 0 1 2-2 2 2 0 0 1 2 2" /></>}
                {b.icon === 'capacity' && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.5 2" /></>}
                {b.icon === 'clay' && <><path d="M3 8l9-5 9 5-9 5-9-5z" /><path d="M3 8v8l9 5 9-5V8" /><path d="M12 13v8" /></>}
                {b.icon === 'fire' && <><path d="M12 3s5 4.5 5 9a5 5 0 0 1-10 0c0-2 1-3.5 1-3.5S9 11 10 11c0-3 2-5 2-8z" /><path d="M12 21a3 3 0 0 0 3-3c0-1.5-1.5-3-1.5-3S12 17 12 18a1 1 0 0 1-1 1" /></>}
                {b.icon === 'conduit' && <><path d="M3 8h6a3 3 0 0 1 3 3v2a3 3 0 0 0 3 3h6" /><circle cx="7" cy="8" r="2" /><circle cx="17" cy="16" r="2" /></>}
              </svg>
            </span>
            <div>
              <h3>{b.title}</h3>
              <p>{b.desc}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Recursos técnicos y preguntas frecuentes -->
  <section class="section section--sand">
    <div class="container split-grid">
      <div class="split-col">
        <span class="section-eyebrow">Centro técnico</span>
        <h2>Información para construir mejor</h2>
        <p>
          Fichas, documentos y consultas para el profesional que tiene que
          definir la obra. Pedinos la documentación y te la enviamos.
        </p>
        <div class="split-actions">
          <a href="/recursos-tecnicos" class="btn btn-primary">Ver recursos técnicos</a>
          <a href="/distribuidores" class="btn btn-secondary">Dónde comprar</a>
        </div>
      </div>

      <div class="split-col">
        <span class="section-eyebrow">Preguntas frecuentes</span>
        <h2>Lo que más nos preguntan</h2>
        <ul class="faq-list">
          {faqHome.map((f) => (
            <li>
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </li>
          ))}
        </ul>
        <a href="/preguntas-frecuentes" class="split-more">
          Ver todas las preguntas
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
               stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA exprés -->
  <section class="section cta-block">
    <div class="container cta-grid">
      <div class="cta-text">
        <span class="cta-pill">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor"
               stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.5 2" />
          </svg>
          Respuesta en menos de 2 horas
        </span>
        <h2>¿Estás construyendo?</h2>
        <p>
          Contanos qué necesitás y nuestro equipo comercial te ayuda a elegir el
          producto adecuado. Presupuesto sin cargo.
        </p>

        <ul class="cta-points">
          <li>
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="M9 12l2 2 4-4" />
            </svg>
            Presupuesto sin cargo
          </li>
          <li>
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
            </svg>
            Precio de fábrica
          </li>
          <li>
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 7h11v9H3z" /><path d="M14 10h4l3 3v3h-7z" /><circle cx="7" cy="18" r="1.8" /><circle cx="17" cy="18" r="1.8" />
            </svg>
            Entrega en obra, a horario
          </li>
        </ul>
      </div>

      <form class="cta-form" method="POST" action="/api/contact.php">
        <h3 class="cta-form-title">Pedí tu presupuesto sin cargo</h3>
        <p class="cta-form-sub">
          Completá tus datos y un asesor técnico se contacta con vos.
        </p>

        <div class="cta-fields">
          <div class="field">
            <label for="cta-name">Tu nombre y apellido <span aria-hidden="true">*</span></label>
            <input type="text" id="cta-name" name="name" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="cta-phone">WhatsApp / Teléfono <span aria-hidden="true">*</span></label>
            <input type="tel" id="cta-phone" name="phone" required autocomplete="tel" />
          </div>
          <div class="field">
            <label for="cta-locality">Localidad o entrega (destino) <span aria-hidden="true">*</span></label>
            <input type="text" id="cta-locality" name="locality" required />
          </div>
          <div class="field">
            <label for="cta-email">Email</label>
            <input type="email" id="cta-email" name="email" autocomplete="email" />
          </div>
        </div>

        <div class="field">
          <label for="cta-msg">Material y cantidad estimada <span aria-hidden="true">*</span></label>
          <textarea
            id="cta-msg"
            name="message"
            rows="3"
            required
            minlength="10"
            maxlength="2000"
            placeholder="Ej: 1.500 ladrillos de 12 + 600 portantes con flete a obra…"
          ></textarea>
        </div>

        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <button type="submit" class="btn btn-rust btn-block btn-lg">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 2 11 13" /><path d="M22 2 15 22l-4-9-9-4 20-7z" />
          </svg>
          Enviar solicitud a ventas
        </button>

        <p class="cta-form-status" data-form-status aria-live="polite"></p>

        <a
          href={`https://wa.me/${company.branches[0].whatsapp}?text=${waQuote}`}
          target="_blank"
          rel="noopener"
          class="btn btn-whatsapp btn-block"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.08-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.87 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.42-.08-.13-.28-.2-.58-.35zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z" />
          </svg>
          Escribir por WhatsApp
        </a>

        <p class="cta-form-note">
          También podés llamarnos al
          <a href={`tel:${company.phone.tel}`}>{company.phone.display}</a> en
          Puerto Rico, Misiones.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  /* — Franja de datos: una tira naranja que separa el hero del contenido — */
  .stats-strip {
    background: var(--brand-orange);
    color: #23150e;
    padding-block: var(--space-5);
  }
  .stats-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-left: var(--space-4);
    border-left: 1px solid rgba(35, 21, 14, 0.22);
  }
  .stat:first-child { padding-left: 0; border-left: 0; }
  .stat-value {
    font-size: var(--fs-700);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .stat-label {
    font-size: var(--fs-100);
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .stat-note {
    font-size: var(--fs-50);
    /* El rgba(35,21,14,.72) sobre el naranja de marca daba 3.45:1 al mezclarse
       con el fondo (#61200a). Este color opaco da 4.72:1 sobre #ff3e00. */
    color: #331605;
    line-height: 1.45;
  }
  @media (max-width: 900px) {
    .stats-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stat:nth-child(3) { padding-left: 0; border-left: 0; }
  }
  @media (max-width: 460px) {
    .stats-list { grid-template-columns: 1fr; }
    .stat { padding-left: 0; border-left: 0; }
  }

  /* — Encabezado de sección — */
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }
  .section-head h2 { margin-bottom: var(--space-2); max-width: 22ch; }
  .section-intro {
    color: var(--text-muted);
    max-width: 62ch;
    margin: 0;
  }
  .section-head-aside {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--brand-rust);
    font-size: var(--fs-100);
    font-weight: 700;
    white-space: nowrap;
    border-bottom: 1px solid var(--accent-line);
    padding-bottom: 2px;
  }
  .section-head-aside:hover { color: var(--brand-deep); border-bottom-color: var(--accent); }
  @media (max-width: 760px) {
    .section-head { flex-direction: column; align-items: flex-start; }
  }

  /* — Selector de uso — */
  .use-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .use-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: var(--space-5);
    background: var(--brand-ink);
    color: var(--on-dark);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: transform var(--t-base), box-shadow var(--t-base);
  }
  .use-card:hover {
    color: var(--on-dark);
    text-decoration: none;
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }
  .use-arrow {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--accent);
