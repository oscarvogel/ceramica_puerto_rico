  .split-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  .faq-list {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .faq-list li {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  .faq-list li:last-child { border-bottom: 0; padding-bottom: 0; }
  .faq-list h3 {
