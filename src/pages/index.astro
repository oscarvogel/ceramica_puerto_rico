  /* — Formulario — */
  .cta-form {
    background: var(--surface);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    color: var(--text);
    box-shadow: var(--shadow-deep);
  }
  .cta-form-title {
    font-size: var(--fs-400);
    margin: 0 0 0.25rem;
    color: var(--brand-ink);
    font-weight: 700;
  }
  .cta-form-sub {
    margin: 0 0 var(--space-5);
