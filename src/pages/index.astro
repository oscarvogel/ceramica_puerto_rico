  .cta-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: #fff;
    color: var(--brand-rust);
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    font-size: var(--fs-50);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    margin-bottom: var(--space-4);
  }
  .cta-text h2 { color: #fff; max-width: 18ch; }
  .cta-text p { color: var(--on-dark-muted); max-width: 52ch; }

  .cta-points {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .cta-points li {
