  .split-more:hover { color: var(--brand-deep); border-bottom-color: var(--accent); }
  @media (max-width: 900px) {
    .split-grid { grid-template-columns: 1fr; gap: var(--space-7); }
  }

  /* — Movimiento: sólo tres bloques de la home se revelan al entrar —
     El resto aparece de una. Un reveal en cada sección se lee como
     plantilla (y retrasa el contenido que el visitante vino a buscar).
     Todo en CSS nativo: animation-timeline + view(), sin JavaScript. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .stat {
        animation: stat-in auto linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 40%;
      }
      .stat:nth-child(2) { animation-range: entry 3% entry 43%; }
      .stat:nth-child(3) { animation-range: entry 6% entry 46%; }
      .stat:nth-child(4) { animation-range: entry 9% entry 49%; }

      .featured-cta {
        animation: bento-in auto linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 30%;
      }
      /* Los productos son otro componente: Astro scopea los estilos, así que
         hace falta :global() para llegar a la raíz de <ProductCard />. */
      .featured-grid > :global(.product-card) {
        animation: bento-in auto linear both;
        animation-timeline: view();
        animation-range: entry 2% entry 32%;
      }
      .featured-grid > :global(.product-card):nth-child(3) { animation-range: entry 5% entry 35%; }
      .featured-grid > :global(.product-card):nth-child(4) { animation-range: entry 8% entry 38%; }
      .featured-grid > :global(.product-card):nth-child(5) { animation-range: entry 11% entry 41%; }
      .featured-grid > :global(.product-card):nth-child(6) { animation-range: entry 14% entry 44%; }
    }
  }

  @keyframes stat-in {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes bento-in {
    from { opacity: 0; transform: translateY(22px); }
    to   { opacity: 1; transform: none; }
  }

  /* — CTA exprés — */
  .cta-block {
    background: var(--brand-ink);
    color: var(--on-dark);
  }
  .cta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    align-items: center;
