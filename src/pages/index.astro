---
/**
 * Home — seguirá la referencia de Stitch:
 * hero · stats · propuesta de valor · catálogo destacado · descargas
 * beneficios · CTA exprés.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard.astro';
import { company } from '../data/company';
import { getFeaturedProducts } from '../data/products';

const featured = getFeaturedProducts();

const stats = [
  { value: '+35', label: 'Años fabricando', note: 'Actividad desde 1975' },
  { value: '100%', label: 'Producción regional', note: 'Hecho en Misiones' },
  { value: 'IRAM', label: 'Norma regional', note: 'Ensayos y trazabilidad' },
  { value: '24–48h', label: 'Despacho a obra', note: 'Logística propia' },
];

const valueProps = [
  {
    icon: 'patented',
    title: 'Stock Constante',
    points: ['Ladrillo hueco 12x18x24', 'Sin esperas de producción', 'Despacho inmediato'],
  },
  {
    icon: 'hydrophobic',
    title: 'Precio de Fábrica',
    points: ['Compra directa', 'Presupuesto sin cargo', 'Factura a nombre propio'],
  },
  {
    icon: 'invoicing',
    title: 'Acompañamos tu Obra',
    points: ['Desde los cimientos', 'Asesoramiento en obra', 'Un interlocutor siempre'],
  },
  {
    icon: 'logistics',
    title: 'Vos construís, nosotros lo llevamos',
    points: ['Camiones propios', 'Carga y descarga en obra', 'Acortamos el tiempo de obra'],
  },
];

const benefits = [
  {
    icon: 'clay',
    title: 'Confiable',
    desc: 'Producto cocido y controlado en cada partida. Misma calidad en la primera y en la última entrega.',
  },
  {
    icon: 'capacity',
    title: 'Eficiente',
    desc: 'Dimensiones uniformes y fácil ejecución. Formatos que simplifican el cómputo y aceleran la obra.',
  },
  {
    icon: 'truck',
    title: 'Puntual',
    desc: 'Logística propia con camiones propios. Llegamos cuando dijimos, y descargamos en obra.',
  },
  {
    icon: 'engineering',
    title: 'Precio de fábrica',
    desc: 'Comprás directo a la planta, sin intermediarios. Presupuesto sin cargo y respuesta rápida.',
  },
];

const breadcrumbs = [{ name: 'Inicio', url: '/' }];

const waQuote = encodeURIComponent(
  'Hola, quiero pedir una cotización para mi obra.',
);
---

<BaseLayout
  title={`${company.name} | Ladrillos Cerámicos en Misiones`}
  description="Fábrica de ladrillos cerámicos huecos en Puerto Rico, Misiones. Conocé nuestros productos, información técnica, distribuidores y solicitá tu presupuesto."
  path="/"
  breadcrumbs={breadcrumbs}
>
  <Hero />

  <!-- Franja de datos -->
  <section class="stats" aria-label="Datos destacados de la empresa">
    <div class="container">
      <ul class="stats-list">
        {stats.map((s) => (
          <li class="stat">
            <span class="stat-value">{s.value}</span>
            <span class="stat-label">{s.label}</span>
            <span class="stat-note">{s.note}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Propuesta de valor -->
  <section class="section section--tight">
    <div class="container">
      <ul class="value-grid">
        {valueProps.map((v) => (
          <li class="card value-card">
            <span class="value-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor"
                   stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                {v.icon === 'patented' && <><rect x="4" y="4" width="16" height="16" rx="2" /><path d="M9 12l2 2 4-4" /></>}
                {v.icon === 'hydrophobic' && <><path d="M12 3s6 6.5 6 10.5A6 6 0 0 1 6 13.5C6 9.5 12 3 12 3z" /><path d="M9.5 14a2.5 2.5 0 0 0 2.5 2.5" /></>}
                {v.icon === 'invoicing' && <><path d="M6 3h9l4 4v14H6z" /><path d="M15 3v4h4M9 12h7M9 16h5" /></>}
                {v.icon === 'logistics' && <><path d="M3 7h11v9H3z" /><path d="M14 10h4l3 3v3h-7z" /><circle cx="7" cy="18" r="1.8" /><circle cx="17" cy="18" r="1.8" /></>}
              </svg>
            </span>
            <h3>{v.title}</h3>
            <ul class="value-points">
              {v.points.map((p) => (
                <li>
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor"
                       stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  {p}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Catálogo destacado -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="section-eyebrow">Catálogo de productos</span>
          <h2>Elegí el material que se ajuste a tu obra</h2>
          <p class="section-intro">
            Ladrillos huecos, portantes y piezas especiales. Filtrá por tipo y
            compará medidas, rendimiento y rendimiento por palet.
          </p>
        </div>
        <a href="/productos" class="section-head-link">
          Ver catálogo completo
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
               stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>

      <div class="grid grid-3">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>

      <div class="downloads-bar">
        <div class="downloads-text">
          <span class="downloads-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor"
                 stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
              <path d="M14 3v5h5M9 13h6M9 17h4" />
            </svg>
          </span>
          <div>
            <p class="downloads-title">Fichas Técnicas &amp; Ensayos de Rotura (PDF)</p>
            <p class="downloads-sub">
              Documentación completa para directores de obra, cálculo estructural y colocación.
            </p>
          </div>
        </div>
        <span class="pending">Documento pendiente</span>
      </div>
    </div>
  </section>

  <!-- Beneficios -->
  <section class="section section--tight">
    <div class="container">
      <div class="section-head section-head--center">
        <div>
          <span class="section-eyebrow">Beneficios productivos</span>
          <h2>Ventajas Cerámica Puerto Rico</h2>
          <p class="section-intro">
            Más de tres décadas abasteciendo obra civil, viviendas unifamiliares
            y edificios de la región.
          </p>
        </div>
      </div>

      <ul class="benefits-grid">
        {benefits.map((b) => (
          <li class="card benefit-card">
            <span class="benefit-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor"
                   stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                {b.icon === 'clay' && <><path d="M3 8l9-5 9 5-9 5-9-5z" /><path d="M3 8v8l9 5 9-5V8" /><path d="M12 13v8" /></>}
                {b.icon === 'capacity' && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.5 2" /></>}
                {b.icon === 'truck' && <><path d="M2 8h12v8H2z" /><path d="M14 11h4l3 3v2h-7z" /><circle cx="6" cy="18" r="1.8" /><circle cx="17" cy="18" r="1.8" /></>}
                {b.icon === 'engineering' && <><path d="M4 20V9l8-6 8 6v11" /><path d="M9 20v-6h6v6" /><path d="M4 13h16" /></>}
              </svg>
            </span>
            <h3>{b.title}</h3>
            <p>{b.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CTA exprés -->
  <section class="section cta-block">
    <div class="container cta-grid">
      <div class="cta-text">
        <span class="cta-pill">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor"
               stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.5 2" />
          </svg>
          Respuesta en menos de 2 horas
        </span>
        <h2>¿Estás construyendo?</h2>
        <p>
          Contanos qué necesitás y nuestro equipo comercial te ayuda a elegir el
          producto adecuado. Presupuesto sin cargo.
        </p>

        <ul class="cta-points">
          <li>
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="M9 12l2 2 4-4" />
            </svg>
            Presupuesto sin cargo
          </li>
          <li>
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
            </svg>
            Precio de fábrica
          </li>
          <li>
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 7h11v9H3z" /><path d="M14 10h4l3 3v3h-7z" /><circle cx="7" cy="18" r="1.8" /><circle cx="17" cy="18" r="1.8" />
            </svg>
            Entrega en obra, a horario
          </li>
        </ul>
      </div>

      <form class="cta-form" method="POST" action="/api/contact.php">
        <h3 class="cta-form-title">Pedí tu presupuesto sin cargo</h3>
        <p class="cta-form-sub">
          Completá tus datos y un asesor técnico se contacta con vos.
        </p>

        <div class="cta-fields">
          <div class="field">
            <label for="cta-name">Tu nombre y apellido <span aria-hidden="true">*</span></label>
            <input type="text" id="cta-name" name="name" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="cta-phone">WhatsApp / Teléfono <span aria-hidden="true">*</span></label>
            <input type="tel" id="cta-phone" name="phone" required autocomplete="tel" />
          </div>
          <div class="field">
            <label for="cta-locality">Localidad o entrega (destino) <span aria-hidden="true">*</span></label>
            <input type="text" id="cta-locality" name="locality" required />
          </div>
          <div class="field">
            <label for="cta-email">Email</label>
            <input type="email" id="cta-email" name="email" autocomplete="email" />
          </div>
        </div>

        <div class="field">
          <label for="cta-msg">Material y cantidad estimada</label>
          <textarea
            id="cta-msg"
            name="message"
            rows="3"
            placeholder="Ej: 1.500 ladrillos de 12 + 600 portantes con flete a obra…"
          ></textarea>
        </div>

        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <button type="submit" class="btn btn-rust btn-block btn-lg">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 2 11 13" /><path d="M22 2 15 22l-4-9-9-4 20-7z" />
          </svg>
          Enviar Solicitud a Ventas
        </button>

        <a
          href={`https://wa.me/${company.branches[0].whatsapp}?text=${waQuote}`}
          target="_blank"
          rel="noopener"
          class="btn btn-whatsapp btn-block"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.08-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.87 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.42-.08-.13-.28-.2-.58-.35zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z" />
          </svg>
          Escribir por WhatsApp
        </a>

        <p class="cta-form-note">
          También podés llamarnos al
          <a href={`tel:${company.phone.tel}`}>{company.phone.display}</a> en
          Puerto Rico, Misiones.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  /* — Franja de datos — */
  .stats {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    padding-block: var(--space-6);
  }
  .stats-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stat { display: flex; flex-direction: column; gap: 0.1rem; }
  .stat-value {
    font-size: var(--fs-700);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--brand-rust);
    line-height: 1.1;
  }
  .stat-label {
    font-size: var(--fs-100);
    font-weight: 600;
    color: var(--brand-ink);
  }
  .stat-note { font-size: var(--fs-50); color: var(--text-soft); }
  @media (max-width: 820px) {
    .stats-list { grid-template-columns: repeat(2, 1fr); }
  }

  /* — Encabezado de sección — */
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }
  .section-head h2 { margin-bottom: var(--space-2); }
  .section-head--center { justify-content: center; text-align: center; }
  .section-head--center > div { max-width: 62ch; }
  .section-intro {
    color: var(--text-muted);
    max-width: 62ch;
    margin: 0;
  }
  .section-head-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
    font-weight: 600;
    font-size: var(--fs-100);
    color: var(--brand-rust);
  }
  .section-head-link:hover { color: var(--brand-deep); }
  .section-head-aside {
    color: var(--text-muted);
    font-size: var(--fs-100);
    margin: 0;
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    .section-head { flex-direction: column; align-items: flex-start; }
  }

  /* — Propuesta de valor — */
  .value-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .value-card { display: flex; flex-direction: column; gap: var(--space-3); }
  .value-icon,
  .benefit-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--accent-soft);
    border: 1px solid var(--accent-line);
    color: var(--accent);
    flex-shrink: 0;
  }
  .value-card h3 {
    font-size: var(--fs-200);
    font-weight: 700;
    margin: 0;
    line-height: 1.35;
  }
  .value-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }
  .value-points li {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    font-size: var(--fs-100);
    color: var(--text-muted);
  }
  .value-points svg { color: var(--ok); flex-shrink: 0; margin-top: 3px; }

  /* — Barra de descargas — */
  .downloads-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin-top: var(--space-5);
    padding: var(--space-4) var(--space-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .downloads-text {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-width: 0;
  }
  .downloads-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background: var(--accent-soft);
    border: 1px solid var(--accent-line);
    color: var(--accent);
  }
  .downloads-title {
    margin: 0 0 0.15rem;
    font-weight: 700;
    color: var(--brand-ink);
    font-size: var(--fs-200);
  }
  .downloads-sub {
    margin: 0;
    font-size: var(--fs-100);
    color: var(--text-muted);
  }

  /* — Beneficios — */
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .benefit-card { display: flex; flex-direction: column; gap: var(--space-3); }
  .benefit-card h3 { font-size: var(--fs-200); margin: 0; line-height: 1.35; }
  .benefit-card p { margin: 0; font-size: var(--fs-100); color: var(--text-muted); }

  /* — CTA exprés — */
  .cta-block {
    background: var(--brand-ink);
    color: var(--on-dark);
  }
  .cta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    align-items: center;
  }
  .cta-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: #fff;
    color: var(--brand-rust);
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    font-size: var(--fs-50);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    margin-bottom: var(--space-4);
  }
  .cta-text h2 { color: #fff; max-width: 18ch; }
  .cta-text p { color: var(--on-dark-muted); max-width: 52ch; }

  .cta-points {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .cta-points li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--fs-100);
    color: var(--on-dark);
  }
  .cta-points svg { color: var(--accent); flex-shrink: 0; }

  /* — Formulario — */
  .cta-form {
    background: var(--surface);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    color: var(--text);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
  }
  .cta-form-title {
    font-size: var(--fs-400);
    margin: 0 0 0.25rem;
    color: var(--brand-ink);
  }
  .cta-form-sub {
    margin: 0 0 var(--space-4);
    font-size: var(--fs-100);
    color: var(--text-muted);
  }
  .cta-fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }
  .field { display: flex; flex-direction: column; gap: 0.3rem; margin-bottom: var(--space-3); }
  .field label {
    font-size: var(--fs-50);
    font-weight: 600;
    color: var(--text-muted);
  }
  .field label span { color: var(--accent); }
  .field input,
  .field textarea {
    width: 100%;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    background: var(--surface);
    font-size: var(--fs-100);
    transition: border-color var(--t-fast), box-shadow var(--t-fast);
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .field textarea { resize: vertical; min-height: 76px; }
  .cta-form .btn { margin-top: var(--space-2); }
  .cta-form .btn + .btn, .cta-form .btn + .cta-form-note { margin-top: var(--space-2); }
  .cta-form-note {
    margin: var(--space-3) 0 0;
    font-size: var(--fs-50);
    color: var(--text-soft);
    text-align: center;
  }
  .cta-form-note a { font-weight: 600; }
  .hp { position: absolute; left: -9999px; }

  @media (max-width: 900px) {
    .cta-grid { grid-template-columns: 1fr; gap: var(--space-6); }
  }
  @media (max-width: 520px) {
    .cta-fields { grid-template-columns: 1fr; }
    .cta-form { padding: var(--space-5); }
  }
</style>
