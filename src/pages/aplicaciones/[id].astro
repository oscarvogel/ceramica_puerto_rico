---
/**
 * Aplicación individual con productos relacionados.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { applications, productsByApplication } from '../../data/applications';
import type { Application } from '../../data/products';

export function getStaticPaths() {
  return applications.map((app) => ({
    params: { id: app.id },
    props: { app },
  }));
}

const { app } = Astro.props;
const products = productsByApplication(app.id as Application);

/**
 * Nº de columnas de la grilla de productos.
 * La grilla automática metía 4 tarjetas por fila y dejaba una sola abajo
 * (4 + 4 + 1). Con las columnas fijas ninguna fila queda con una sola
 * tarjeta: 9 productos van 3+3+3, 4 van 4 en una fila, 3 van 3.
 */
const cols = products.length % 3 === 0 ? 3 : Math.max(products.length, 2);
/** Con 2 productos no conviene estirarlos a media pantalla: se limitan a 420px. */
const gridMax = products.length <= 2 ? '860px' : 'none';

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Aplicaciones', url: '/aplicaciones' },
  { name: app.title, url: `/aplicaciones/${app.id}` },
];
---

<BaseLayout
  title={`${app.title} | Cerámica Puerto Rico`}
  description={app.description}
  path={`/aplicaciones/${app.id}`}
  breadcrumbs={breadcrumbs}
>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb">
        {breadcrumbs.map((b, i) => (
          <span>
            <a href={b.url}>{b.name}</a>
            {i < breadcrumbs.length - 1 && <span class="sep">›</span>}
          </span>
        ))}
      </nav>
      <h1>{app.title}</h1>
      <p class="page-hero-sub">{app.description}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {products.length > 0 ? (
        <>
          <h2>Productos recomendados</h2>
          <div
            class="products-grid"
            style={`--cols: ${cols}; --grid-max: ${gridMax};`}
          >
            {products.map((p) => <ProductCard product={p} />)}
          </div>
        </>
      ) : (
        <div class="empty-state">
          <p>Próximamente publicaremos los productos recomendados para esta aplicación.</p>
          <a href="/productos" class="btn btn-primary">Ver catálogo completo</a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: var(--color-terracota-50);
    padding-block: var(--space-8);
  }
  .breadcrumb {
    font-size: var(--fs-100);
    color: var(--color-grafito-500);
    margin-bottom: var(--space-4);
  }
  .breadcrumb a { color: var(--color-grafito-500); }
  .breadcrumb a:hover { color: var(--color-terracota-600); }
  .breadcrumb .sep { margin: 0 0.5rem; color: var(--color-grafito-300); }
  .page-hero h1 { font-size: clamp(2rem, 4vw, 3rem); margin-bottom: var(--space-3); }
  .page-hero-sub { color: var(--color-grafito-500); max-width: 60ch; margin: 0; }
  .empty-state {
    background: var(--color-blanco);
    padding: var(--space-7);
    border-radius: var(--radius-lg);
    text-align: center;
    border: 1px dashed var(--color-grafito-100);
  }

  /* — Grilla de productos — */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    gap: var(--space-5);
    max-width: var(--grid-max, none);
    margin-inline: auto;
  }
  @media (max-width: 760px) {
    .products-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: none;
    }
  }
  @media (max-width: 480px) {
    .products-grid { grid-template-columns: 1fr; }
  }
</style>
