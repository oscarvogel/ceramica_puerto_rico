---
/**
 * Productos — listado con filtros básicos.
 * SPEC §15: filtros por aplicación / tipo / uso. Cada producto con ficha.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, productTypes } from '../../data/products';

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Productos', url: '/productos' },
];
---

<BaseLayout
  title="Ladrillos Cerámicos Huecos | Cerámica Puerto Rico"
  description="Conocé la línea de ladrillos cerámicos Cerámica Puerto Rico: medidas, aplicaciones, rendimiento, información técnica y disponibilidad."
  path="/productos"
  breadcrumbs={breadcrumbs}
>
  <section class="page-hero">
    <div class="container">
      <span class="section-eyebrow">Catálogo</span>
      <h1>Ladrillos cerámicos para cada obra</h1>
      <p class="page-hero-sub">
        Línea de ladrillos huecos y portantes producidos en nuestra planta de
        Puerto Rico, Misiones. Información técnica completa una vez validada
        con el fabricante.
      </p>
    </div>
  </section>

  <section class="section catalog-section">
    <div class="container">
      <div class="filters">
        <div class="filters-head">
          <h2 class="filters-title">Filtrar por tipo</h2>
          <span class="filters-count" data-filter-count>{products.length} productos</span>
        </div>
        <ul class="filter-list">
          <li><a href="/productos" class="filter-chip is-active" data-filter-chip>Todos</a></li>
          {productTypes.map((t) => (
            <li><a href={`/productos?type=${t.id}`} class="filter-chip" data-filter-chip>{t.label}</a></li>
          ))}
        </ul>
        <p class="filters-note">
          El catálogo definitivo se publica una vez validadas las medidas y rendimientos con el fabricante.
        </p>
      </div>

      <div class="grid-balanced product-grid" data-product-grid>
        {products.map((p) => (
          <div class="product-cell" data-type={p.type}>
            <ProductCard product={p} />
          </div>
        ))}
      </div>

      <p class="filters-empty" data-filter-empty hidden>
        No hay productos de ese tipo. <a href="/productos">Ver todos</a>
      </p>
    </div>
  </section>

  <section class="section section--tight section--dark">
    <div class="container cta-block">
      <div>
        <h2>¿Necesitás ayuda para elegir?</h2>
        <p>Contanos qué tipo de obra estás planificando y te recomendamos el producto.</p>
      </div>
      <a href="/contacto" class="btn btn-primary">Solicitar asesoramiento</a>
    </div>
  </section>
</BaseLayout>

<style>
.page-hero {
    background: var(--color-terracotta-50);
    padding-block: var(--space-7) var(--space-6);
  }

  /* El padding de .section (space-9) mas el del hero dejaba ~150px de vacio
     entre el subtitulo y los filtros. Solo se achica en el catalogo. */
  .catalog-section {
    padding-block: var(--space-6);
  }
  @media (max-width: 640px) {
    .page-hero { padding-block: var(--space-6) var(--space-5); }
    .catalog-section { padding-block: var(--space-5); }
  }
  .page-hero h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: var(--space-3);
  }
  .page-hero-sub {
    color: var(--color-grafito-500);
    max-width: 60ch;
    margin: 0;
  }

  .filters {
    margin-bottom: var(--space-5);
  }
  .filters-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }
  .filters-title {
    font-size: var(--fs-300);
    margin: 0;
  }
  .filters-count {
    font-size: var(--fs-100);
    color: var(--color-grafito-500);
  }
  .filters-empty {
    margin: var(--space-5) 0 0;
    color: var(--color-grafito-500);
  }
  .filters-empty a {
    color: var(--color-terracotta-600);
    font-weight: 600;
  }

  /* La celda se oculta con el atributo hidden, pero .grid-balanced > * gana
     en especificidad y la seguiria mostrando. */
  .product-cell[hidden] {
    display: none;
  }
  .filter-list {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-3);
    flex-wrap: wrap;
  }
  .filter-chip {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--color-grafito-100);
    color: var(--color-grafito-700);
    font-size: var(--fs-100);
    font-weight: 500;
    background: var(--color-blanco);
  }
  .filter-chip:hover { border-color: var(--color-terracota-500); color: var(--color-terracota-600); }
  .filter-chip.is-active {
    background: var(--color-terracota-500);
    border-color: var(--color-terracota-500);
    color: var(--color-blanco);
  }
  .filters-note {
    color: var(--color-grafito-500);
    font-size: var(--fs-100);
    margin: 0;
  }

  .cta-block {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }
  .cta-block h2 { color: var(--color-blanco); margin-bottom: var(--space-2); }
  .cta-block p { color: var(--color-grafito-100); margin: 0; }
</style>

<script>
  /**
   * Filtro por tipo.
   *
   * El sitio se genera estatico: hay un unico HTML para /productos, asi que
   * Astro.url.searchParams llega vacio en build y filtrar en el servidor no
   * funciona. Por eso el filtro corre aca, sobre los chips que ya apuntan a
   * ?type=... para que los enlaces sigan siendo compartibles.
   */
  const grid = document.querySelector<HTMLElement>('[data-product-grid]');
  const chips = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-filter-chip]'));
  const counter = document.querySelector<HTMLElement>('[data-filter-count]');
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
  const cells = grid ? Array.from(grid.querySelectorAll<HTMLElement>('[data-type]')) : [];

  const typeOf = (chip: HTMLAnchorElement) => new URL(chip.href).searchParams.get('type');

  function apply(type: string | null, push = false) {
    let shown = 0;
    for (const cell of cells) {
      const match = !type || cell.dataset.type === type;
      cell.hidden = !match;
      if (match) shown++;
    }
    for (const chip of chips) {
      chip.classList.toggle('is-active', typeOf(chip) === type);
    }
    if (counter) {
      counter.textContent = type
        ? `${shown} de ${cells.length} productos`
        : `${cells.length} productos`;
    }
    if (empty) empty.hidden = shown > 0;
    if (push) {
      const url = type ? `${location.pathname}?type=${encodeURIComponent(type)}` : location.pathname;
      history.pushState({ type }, '', url);
    }
  }

  for (const chip of chips) {
    chip.addEventListener('click', (event) => {
      event.preventDefault();
      apply(typeOf(chip), true);
      grid?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  window.addEventListener('popstate', () => {
    apply(new URLSearchParams(location.search).get('type'));
  });

  // arranca con el filtro que venga en la URL, por si se comparte o recarga
  apply(new URLSearchParams(location.search).get('type'));
</script>
