---
/**
 * Contacto — SPEC §21. Formulario con honeypot + endpoint PHP.
 * El form apunta a /api/contact.php (incluido en /public/api).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { company } from '../data/company';

const breadcrumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Contacto', url: '/contacto' },
];

const profiles = [
  { value: 'constructor', label: 'Soy constructor' },
  { value: 'arquitecto', label: 'Soy arquitecto / ingeniero' },
  { value: 'corralon', label: 'Tengo un corralón' },
  { value: 'distribuidor', label: 'Quiero ser distribuidor' },
  { value: 'particular', label: 'Soy particular' },
];

const waText = encodeURIComponent('Hola, quiero hacer una consulta sobre Cerámica Puerto Rico.');
const waHref = `https://wa.me/${company.branches[0].whatsapp}?text=${waText}`;

/**
 * Ubicación de la planta. El mapa embebido usa el query de búsqueda con la
 * dirección, así que se actualiza solo si la empresa muda la planta.
 */
const mapsQuery = encodeURIComponent(
  `${company.address.street}, ${company.address.locality}, ${company.address.province}, Argentina`,
);
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapsQuery}`;
const mapsEmbed = `https://maps.google.com/maps?q=${mapsQuery}&z=16&output=embed`;
---

<BaseLayout
  title="Contacto | Cerámica Puerto Rico – Misiones"
  description="Contactá a Cerámica Puerto Rico: planta en Puerto Rico, Misiones. Pedí tu cotización por WhatsApp o completá el formulario comercial."
  path="/contacto"
  breadcrumbs={breadcrumbs}
>
  <section class="page-hero">
    <div class="container">
      <span class="section-eyebrow">Contacto</span>
      <h1>Hablemos de tu obra</h1>
      <p class="page-hero-sub">
        Pedinos cotización, asesoramiento técnico o información sobre distribución.
        Te respondemos a la brevedad.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <!-- Datos -->
      <aside class="contact-info">
        <div class="card">
          <h2>Planta y ventas</h2>
          <p>{company.address.street}</p>
          <p>{company.address.locality}, {company.address.province}</p>
          <p>{company.address.country}</p>
          <p class="contact-phone">
            <a href={`tel:${company.phone.tel}`}>{company.phone.display}</a>
          </p>
          <a
            class="contact-map-link"
            href={mapsUrl}
            target="_blank"
            rel="noopener"
          >
            Ver la ubicación en el mapa
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor"
                 stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
          <div class="contact-map">
            <iframe
              src={mapsEmbed}
              title="Ubicación de la planta de Cerámica Puerto Rico en Puerto Rico, Misiones"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          </div>
        </div>

        <div class="card">
          <h2>Teléfonos</h2>
          <ul class="contact-areas">
            {company.areas.map((a) => (
              <li>
                <span class="contact-area-label">{a.label}</span>
                <a href={`tel:${a.tel}`}>{a.display}</a>
              </li>
            ))}
          </ul>
        </div>

        <!-- WhatsApp y Redes: dos cuadrados, uno al lado del otro -->
        <div class="contact-channels">
          <div class="card channel-card">
            <span class="channel-icon channel-icon--wa" aria-hidden="true">
              <svg viewBox="0 0 32 32" width="26" height="26" fill="currentColor">
                <path d="M16 3C9.4 3 4 8.4 4 15c0 2.5.8 4.8 2.2 6.8L4 29l7.4-2.2c1.4.6 3 .9 4.6.9 6.6 0 12-5.4 12-12S22.6 3 16 3zm0 21.8c-1.5 0-2.9-.4-4.1-1.1l-.3-.2-4.4 1.3 1.3-4.3-.2-.3a9.7 9.7 0 0 1-1.5-5.2c0-5.4 4.4-9.7 9.7-9.7s9.7 4.4 9.7 9.7-4.3 9.8-9.7 9.8zM21.6 18c-.3-.2-1.7-.8-2-.9-.3-.1-.5-.2-.7.2-.2.3-.8.9-1 1.1-.2.2-.4.2-.6 0-.3-.2-1.2-.4-2.3-1.4-.8-.7-1.4-1.7-1.6-2-.2-.3 0-.5.1-.7l.4-.5c.2-.2.2-.4.4-.6.1-.2 0-.4 0-.6 0-.2-.7-1.7-1-2.3-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4 0 1.4 1 2.8 1.2 3 .1.2 2 3 4.8 4.2 2.8 1.2 2.8.8 3.3.8.5-.1 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.5-.3z" />
              </svg>
            </span>
            <h3>WhatsApp</h3>
            <p>Atención comercial directa.</p>
            <a href={waHref} target="_blank" rel="noopener" class="btn btn-whatsapp">
              Abrir WhatsApp
            </a>
          </div>

          <div class="card channel-card">
            <span class="channel-icon channel-icon--ig" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor"
                   stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
              </svg>
            </span>
            <h3>Redes</h3>
            <p>Seguinos y escribinos.</p>
            <div class="channel-socials">
              <a
                href={company.social.instagram}
                target="_blank"
                rel="noopener"
                class="btn btn-social btn-social--ig"
              >
                Instagram
              </a>
              <a
                href={company.social.facebook}
                target="_blank"
                rel="noopener"
                class="btn btn-social btn-social--fb"
              >
                Facebook
              </a>
            </div>
          </div>
        </div>
      </aside>

      <!-- Formulario -->
      <div>
        <h2>Envianos tu consulta</h2>
        <p class="form-intro">
          Los campos con <span aria-hidden="true">*</span> son obligatorios.
        </p>

        <form
          action="/api/contact.php"
          method="POST"
          class="contact-form"
          data-contact-form
        >
          <!-- Honeypot anti-spam -->
          <div class="hp" aria-hidden="true">
            <label for="website">No completar este campo</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <label class="field">
            <span>Nombre y apellido <span aria-hidden="true">*</span></span>
            <input type="text" name="name" required minlength="2" maxlength="120" />
          </label>

          <div class="field-row">
            <label class="field">
              <span>Email <span aria-hidden="true">*</span></span>
              <input type="email" name="email" required />
            </label>
            <label class="field">
              <span>Teléfono / WhatsApp</span>
              <input type="tel" name="phone" />
            </label>
          </div>

          <label class="field">
            <span>Soy <span aria-hidden="true">*</span></span>
            <select name="profile" required>
              <option value="">Elegí una opción</option>
              {profiles.map((p) => (
                <option value={p.value}>{p.label}</option>
              ))}
            </select>
          </label>

          <label class="field">
            <span>Localidad</span>
            <input type="text" name="locality" maxlength="120" />
          </label>

          <label class="field">
            <span>Consulta <span aria-hidden="true">*</span></span>
            <textarea name="message" required minlength="10" rows="6" maxlength="2000"></textarea>
          </label>

          <button type="submit" class="btn btn-primary">Enviar consulta</button>

          <p class="form-status" data-form-status aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>

  <!-- Recursos humanos -->
  <section class="section section--tight">
    <div class="container">
      <div class="card rrhh-card">
        <div>
          <h2>¿Querés trabajar con nosotros?</h2>
          <p>
            Los interesados en formar parte de nuestro equipo pueden enviar su
            currículum a <a href={`mailto:${company.email.rrhh}`}>{company.email.rrhh}</a>, especificando en el
            asunto: nombre, contacto, fecha de nacimiento, dirección, estudios,
            experiencia, referencia y demás información que quieran agregar.
          </p>
        </div>
        <a
          href={`mailto:${company.email.rrhh}?subject=${encodeURIComponent('Curriculum - Postulación')}`}
          class="btn btn-secondary"
        >
          Enviar currículum
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');
  const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  const ICONS = {
    pending: '<svg class="spinner" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.2-8.55"/></svg>',
    success: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>',
    error: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>',
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status || !submitBtn) return;

    status.dataset.kind = 'pending';
    status.innerHTML = `${ICONS.pending}<span>Enviando tu consulta...</span>`;
    submitBtn.disabled = true;

    const data = new FormData(form);
    // Agregar contexto: de dónde vino el usuario
    const ref = document.referrer;
    if (ref && ref.includes(window.location.host)) {
      data.append('_from', ref);
    }

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { 'Accept': 'application/json' },
      });
      const json = await res.json().catch(() => ({}));
      if (res.ok && json.ok) {
        status.dataset.kind = 'success';
        status.innerHTML = `${ICONS.success}<span><strong>¡Gracias!</strong> Recibimos tu consulta y te respondemos a la brevedad.</span>`;
        form.reset();
        status.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        throw new Error(json.message || 'Error del servidor');
      }
    } catch {
      status.dataset.kind = 'error';
      status.innerHTML = `${ICONS.error}<span>No pudimos enviar tu consulta. Probá de nuevo o escribinos por WhatsApp.</span>`;
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>

<style>
  .page-hero {
    background: var(--color-terracota-50);
    padding-block: var(--space-8);
  }
  .page-hero h1 { font-size: clamp(2rem, 4vw, 3rem); margin-bottom: var(--space-3); }
  .page-hero-sub { color: var(--color-grafito-500); margin: 0; max-width: 60ch; }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: var(--space-7);
  }
  @media (max-width: 800px) { .contact-grid { grid-template-columns: 1fr; } }

  .contact-info { display: grid; gap: var(--space-4); align-content: start; }
  .contact-info h2 { font-size: var(--fs-400); margin-bottom: var(--space-3); }
  .contact-info p { color: var(--color-grafito-500); margin: 0 0 var(--space-1); }
  .contact-phone a { font-size: var(--fs-400); font-weight: 700; color: var(--color-grafito-900); }
  .social-links { list-style: none; padding: 0; margin: 0; }
  .social-links li { padding: var(--space-1) 0; }

  /* — Mapa de la planta — */
  .contact-map-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: var(--space-3);
    font-size: var(--fs-100);
    font-weight: 600;
    color: var(--color-terracota-600);
  }
  .contact-map-link:hover { color: var(--color-terracota-500); }
  .contact-map {
    margin-top: var(--space-3);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-grafito-100);
    aspect-ratio: 4 / 3;
  }
  .contact-map iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* — Teléfonos por área — */
  .contact-areas { list-style: none; padding: 0; margin: 0; }
  .contact-areas li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-grafito-100);
  }
  .contact-areas li:last-child { border-bottom: 0; }
  .contact-area-label {
    font-size: var(--fs-100);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-grafito-500);
  }
  .contact-areas a { font-weight: 600; color: var(--color-grafito-900); }

  /* — WhatsApp y Redes: dos cuadrados lado a lado — */
  .contact-channels {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    justify-items: center;
  }
  .channel-card {
    aspect-ratio: 1 / 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--space-2);
    padding: var(--space-4);
  }
  .channel-card h3 { font-size: var(--fs-300); margin: 0; }
  .channel-card p {
    color: var(--color-grafito-500);
    margin: 0;
    font-size: var(--fs-50);
    max-width: 22ch;
  }
  .channel-icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    margin-bottom: var(--space-1);
  }
  .channel-icon--wa { background: #e7f7ed; color: #1faa54; }
  .channel-icon--ig { background: #f4ecf7; color: #b0439b; }
  .channel-card .btn { margin-top: var(--space-2); }
  .channel-socials {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
    margin-top: var(--space-2);
  }
  .btn-social {
    justify-content: center;
    border: 0;
    font-size: var(--fs-50);
    font-weight: 600;
    color: #fff;
  }
  .btn-social--ig { background: #b0439b; }
  .btn-social--ig:hover { background: #94357f; color: #fff; }
  .btn-social--fb { background: #1877f2; }
  .btn-social--fb:hover { background: #0f5fc4; color: #fff; }

  @media (max-width: 420px) {
    .contact-channels { grid-template-columns: 1fr; }
    .channel-card { aspect-ratio: auto; }
  }

  /* — Recursos humanos — */
  .rrhh-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    flex-wrap: wrap;
  }
  .rrhh-card h2 { font-size: var(--fs-400); margin-bottom: var(--space-2); }
  .rrhh-card p {
    color: var(--color-grafito-500);
    margin: 0;
    max-width: 70ch;
  }
  .rrhh-card p a {
    color: var(--color-terracota-600);
    font-weight: 600;
    word-break: break-word;
  }

  .form-intro { color: var(--color-grafito-500); margin-bottom: var(--space-5); }
  .contact-form {
    display: grid;
    gap: var(--space-4);
    background: var(--color-blanco);
    padding: var(--space-6);
    border: 1px solid var(--color-grafito-100);
    border-radius: var(--radius-lg);
  }
  .field { display: flex; flex-direction: column; gap: var(--space-1); font-size: var(--fs-100); }
  .field span { color: var(--color-grafito-700); font-weight: 500; }
  .field input, .field select, .field textarea {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-grafito-100);
    border-radius: var(--radius-md);
    background: var(--color-blanco);
    font-family: inherit;
  }
  .field input:focus, .field select:focus, .field textarea:focus {
    outline: 2px solid var(--color-terracota-500);
    outline-offset: 1px;
  }
  .field textarea { resize: vertical; min-height: 120px; }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }
  @media (max-width: 480px) { .field-row { grid-template-columns: 1fr; } }

  .hp { position: absolute; left: -9999px; height: 0; width: 0; overflow: hidden; }
  .form-status {
    display: none;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    font-size: var(--fs-100);
    margin: 0;
    line-height: 1.5;
  }
  .form-status:not([data-kind=""]) { display: flex; }
  .form-status[data-kind="success"] {
    background: #ecfdf5;
    color: #1b7a3d;
    border: 1px solid #a7f3d0;
  }
  .form-status[data-kind="error"] {
    background: #fef2f2;
    color: var(--color-error);
    border: 1px solid #fecaca;
  }
  .form-status[data-kind="pending"] {
    background: var(--color-grafito-50);
    color: var(--color-grafito-700);
    border: 1px solid var(--color-grafito-100);
  }
  .form-status svg { flex-shrink: 0; }
  .btn[disabled] { opacity: 0.6; cursor: not-allowed; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .spinner { animation: spin 0.8s linear infinite; }
</style>
