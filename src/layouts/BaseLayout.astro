---
/**
 * BaseLayout.astro — Layout raíz con header, footer, fuentes y SEO.
 * Carga Inter desde Google Fonts (SPEC §29 — sans serif contemporánea).
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import BackToTop from '../components/BackToTop.astro';
import Seo from '../components/Seo.astro';
import fs from 'node:fs';
// Aliaseado: la prop `path` de Astro usa ese nombre y lo pisa.
import nodePath from 'node:path';
import { createHash } from 'node:crypto';

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  breadcrumbs?: { name: string; url: string }[];
  faqJsonLd?: { q: string; a: string }[];
  productJsonLd?: Record<string, unknown>;
}

const { title, description, path, ogImage, type, breadcrumbs, faqJsonLd, productJsonLd } =
  Astro.props;

/**
 * Version de los iconos: hash del contenido del favicon.svg.
 * Los navegadores cachean los favicon y no los revalidan, asi que si la URL
 * no cambia el sitio sigue mostrando el icono viejo aunque se publique uno
 * nuevo. Con el hash en la URL, cambiar el icono cambia la URL y el
 * navegador vuelve a pedirlo. Se regenera con `npm run iconos`.
 */
const iconVersion = createHash('sha256')
  .update(fs.readFileSync(nodePath.join(process.cwd(), 'public', 'favicon.svg')))
  .digest('hex')
  .slice(0, 8);
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Iconos. El favicon usa el monograma real de la marca (public/logo.svg),
         no un dibujo a mano: SVG para los navegadores modernos, .ico real con
         16/32/48 para los viejos, apple-touch-icon para iOS y manifest para
         Android (que antes daba 404). El ?v= es el hash del contenido: sin el,
         el navegador sigue mostrando el icono viejo (no revalida el favicon). -->
    <link rel="icon" type="image/svg+xml" href={`/favicon.svg?v=${iconVersion}`} />
    <link rel="icon" href={`/favicon.ico?v=${iconVersion}`} sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href={`/apple-touch-icon.png?v=${iconVersion}`} />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Las tipografías están auto-hospedadas: cero requests a terceros en el
         camino crítico. Se precargan las dos que se ven en el primer pintado. -->
    <link
      rel="preload"
      href="/fonts/archivo-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <Seo
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      type={type}
      breadcrumbs={breadcrumbs}
      faqJsonLd={faqJsonLd}
      productJsonLd={productJsonLd}
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido principal</a>
    <div class="reading-progress" aria-hidden="true"></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <BackToTop />
  </body>

  <script>
    /* Header sombra al scrollear + botón "volver arriba".
       El listener no dispara trabajo por evento: se agrupan los callbacks
       en un frame con requestAnimationFrame. */
    const header = document.querySelector('.site-header');
    const backBtn = document.getElementById('back-to-top');
    let ticking = false;

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const scrolled = window.scrollY > 10;
        header?.classList.toggle('is-scrolled', scrolled);

        const showBtn = window.scrollY > Math.max(window.innerHeight * 0.5, 600);
        backBtn?.classList.toggle('is-visible', showBtn);
        ticking = false;
      });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  </script>
</html>

<style>
  /* — Barra de progreso de lectura —
     Se dibuja con scaleX sobre scroll(root): corre en el hilo compositor
     y no toca el hilo principal. Si el navegador no lo soporta, no se muestra. */
  .reading-progress {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--accent);
    transform-origin: 0 50%;
    scale: 0 1;
    z-index: 200;
    pointer-events: none;
  }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .reading-progress {
        display: block;
        animation: reading-progress-x auto linear both;
        animation-timeline: scroll(root);
      }
      @keyframes reading-progress-x {
        to { scale: 1 1; }
      }
    }
  }
</style>
