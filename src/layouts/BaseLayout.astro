---
/**
 * BaseLayout.astro — Layout raíz con header, footer, fuentes y SEO.
 * Carga Inter desde Google Fonts (SPEC §29 — sans serif contemporánea).
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import BackToTop from '../components/BackToTop.astro';
import Seo from '../components/Seo.astro';

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  breadcrumbs?: { name: string; url: string }[];
  faqJsonLd?: { q: string; a: string }[];
  productJsonLd?: Record<string, unknown>;
}

const { title, description, path, ogImage, type, breadcrumbs, faqJsonLd, productJsonLd } =
  Astro.props;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Las tipografías están auto-hospedadas: cero requests a terceros en el
         camino crítico. Se precargan las dos que se ven en el primer pintado. -->
    <link
      rel="preload"
      href="/fonts/archivo-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <Seo
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      type={type}
      breadcrumbs={breadcrumbs}
      faqJsonLd={faqJsonLd}
      productJsonLd={productJsonLd}
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido principal</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <BackToTop />
  </body>

  <script>
    /* Header sombra al scrollear + botón "volver arriba".
       El listener no dispara trabajo por evento: se agrupan los callbacks
       en un frame con requestAnimationFrame. */
    const header = document.querySelector('.site-header');
    const backBtn = document.getElementById('back-to-top');
    let ticking = false;

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const scrolled = window.scrollY > 10;
        header?.classList.toggle('is-scrolled', scrolled);

        const showBtn = window.scrollY > Math.max(window.innerHeight * 0.5, 600);
        backBtn?.classList.toggle('is-visible', showBtn);
        ticking = false;
      });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  </script>
</html>
