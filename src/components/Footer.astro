---
/**
 * Footer.astro — 4 columnas (marca, catálogo técnico, planta y logística,
 * cotización inmediata) + barra legal inferior.
 */
import Logo from './Logo.astro';
import { company } from '../data/company';

const year = new Date().getFullYear();

const catalogLinks = [
  { href: '/productos?type=portante', label: 'Ladrillos Portantes' },
  { href: '/productos?type=visto', label: 'Ladrillos Vistos' },
  { href: '/productos?type=liviano', label: 'Ladrillos Livianos' },
  { href: '/productos?type=encadenado', label: 'Peine Encadenado' },
  { href: '/aplicaciones', label: 'Aplicaciones' },
  { href: '/productos', label: 'Ver catálogo completo' },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label={`Ir al inicio de ${company.name}`}>
          <Logo height={34} />
        </a>
        <p class="footer-desc">
          Fabricación y distribución de ladrillos cerámicos huecos, portantes y
          piezas de alta resistencia estructural. Soluciones para constructoras
          desde Puerto Rico, Misiones.
        </p>
        <p class="footer-contact">
          <a href={`tel:${company.phone.tel}`}>{company.phone.display}</a>
        </p>
      </div>

      <nav class="footer-col" aria-label="Catálogo técnico">
        <h4>Catálogo Técnico</h4>
        <ul>
          {catalogLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="footer-col">
        <h4>Planta &amp; Logística</h4>
        <ul class="footer-places">
          <li>
            <span class="footer-place-title">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-5h6v5" />
              </svg>
              Planta Industrial
            </span>
            <span class="footer-place-text">
              {company.address.street}, {company.address.locality},
              {company.address.province}
            </span>
          </li>
          <li>
            <span class="footer-place-title">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="5.5" cy="17.5" r="2.5" />
                <circle cx="18.5" cy="17.5" r="2.5" />
                <path d="M8 17.5h8M12 17.5V6h6.5v11.5" />
              </svg>
              Despacho y Ventas
            </span>
            <span class="footer-place-text">
              {company.hours.display}
            </span>
          </li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Cotización Inmediata</h4>
        <p class="footer-cta-text">
          Atención técnica especializada para soluciones de arquitectura,
          constructores y obras civiles.
        </p>
        <div class="footer-cta-actions">
          <a href="/contacto" class="btn btn-primary btn-block">Solicitar Presupuesto</a>
          <a href="/distribuidores" class="btn btn-secondary btn-block">
            Ver puntos de venta
          </a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {company.legalName}. Todos los derechos reservados.</p>
      <ul class="footer-areas">
        {company.areas.map((a) => (
          <li>
            <span class="footer-area-label">{a.label}</span>
            <a href={`tel:${a.tel}`}>{a.display}</a>
          </li>
        ))}
      </ul>
      <ul class="footer-legal">
        <li><a href="/historia-y-proceso">Industria Misionera</a></li>
        <li><a href="/distribuidores">Distribuidores</a></li>
        <li><a href="/recursos-tecnicos">Recursos técnicos</a></li>
        <li><a href="/preguntas-frecuentes">Preguntas frecuentes</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  /* El footer cierra en anthracita: el sitio alterna superficies claras y
     oscuras para que la página tenga profundidad y no sea un plano crema. */
  .site-footer {
    background: var(--brand-ink);
    color: var(--on-dark-muted);
    border-top: 1px solid rgba(245, 241, 236, 0.14);
    padding-block: var(--space-8) var(--space-5);
    font-size: var(--fs-100);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1.1fr 1.1fr 1.1fr;
    gap: var(--space-7);
  }

  .footer-logo { display: inline-block; text-decoration: none; margin-bottom: var(--space-4); }
  .footer-desc { font-size: var(--fs-100); line-height: 1.65; margin-bottom: var(--space-4); }
  .footer-contact { margin: 0; }
  .footer-contact a {
    color: #fff;
    font-weight: 700;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-200);
  }
  .footer-contact a:hover { color: var(--accent-on-dark); }

  .footer-col h4 {
    color: #fff;
    font-size: var(--fs-100);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    margin-bottom: var(--space-4);
  }
  .footer-col ul { list-style: none; margin: 0; padding: 0; }
  .footer-col li { margin-bottom: var(--space-3); }

  .footer-col a { color: var(--on-dark-muted); font-size: var(--fs-100); }
  .footer-col a:hover { color: var(--accent-on-dark); }

  .footer-places li { display: flex; flex-direction: column; gap: 0.2rem; }
  .footer-place-title {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #fff;
    font-weight: 600;
    font-size: var(--fs-100);
  }
  .footer-place-title svg { color: var(--accent-on-dark); }
  .footer-place-text { color: var(--on-dark-muted); font-size: var(--fs-50); line-height: 1.6; }

  .footer-cta-text { font-size: var(--fs-100); line-height: 1.6; margin-bottom: var(--space-4); }
  .footer-cta-actions { display: grid; gap: var(--space-2); }
  .footer-cta-actions .btn { font-size: var(--fs-100); }
  /* Sobre anthracita, el botón secundario necesita su propio contraste. */
  .footer-cta-actions .btn-secondary {
    color: #fff;
    border-color: rgba(245, 241, 236, 0.35);
  }
  .footer-cta-actions .btn-secondary:hover {
    background: #fff;
    color: var(--brand-ink);
    border-color: #fff;
  }

  .footer-bottom {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid rgba(245, 241, 236, 0.14);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    color: var(--on-dark-muted);
    font-size: var(--fs-50);
  }
  .footer-bottom p { margin: 0; }

  .footer-areas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-areas li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
  }
  .footer-area-label {
    text-transform: uppercase;
    letter-spacing: 0.07em;
    font-weight: 600;
    color: var(--on-dark-muted);
  }
  .footer-areas a {
    color: #fff;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-weight: 500;
  }
  .footer-areas a:hover { color: var(--accent-on-dark); }
  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-legal a { color: var(--on-dark-muted); }
  .footer-legal a:hover { color: var(--accent-on-dark); }

  @media (max-width: 1000px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .footer-grid { grid-template-columns: 1fr; gap: var(--space-6); }
  }
</style>
