---
/**
 * Header.astro
 * Barra superior oscura (datos de planta + horario) + navegación principal
 * con CTA "Pedir Presupuesto". En móvil: menú colapsable.
 */
import Logo from './Logo.astro';
import { company } from '../data/company';

const navItems = [
  { href: '/productos', label: 'Productos' },
  { href: '/aplicaciones', label: 'Aplicaciones' },
  { href: '/empresa#obras', label: 'Obras & Noticias' },
  { href: '/distribuidores', label: 'Distribuidores' },
  { href: '/contacto', label: 'Contacto' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  const base = href.split('#')[0];
  return currentPath === base || currentPath.startsWith(base + '/');
};
---

<div class="topbar">
  <div class="container topbar-inner">
    <p class="topbar-lead">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-5h6v5" />
      </svg>
      Fábrica en Puerto Rico, Misiones
    </p>
    <ul class="topbar-list">
      <li>
        <a href={`tel:${company.phone.tel}`}>{company.phone.display}</a>
      </li>
      <li class="topbar-sep" aria-hidden="true"></li>
      <li class="topbar-hours">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 7v5l3.5 2" />
        </svg>
        {company.hours.display}
      </li>
    </ul>
  </div>
</div>

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`Ir al inicio de ${company.name}`}>
      <Logo height={38} />
    </a>

    <button class="nav-toggle" aria-label="Abrir menú" aria-expanded="false"
            aria-controls="site-nav" data-nav-toggle>
      <span></span><span></span><span></span>
    </button>

    <nav class="site-nav" id="site-nav" data-site-nav aria-label="Navegación principal">
      <ul>
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link', { 'is-active': isActive(item.href) }]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a href="/contacto" class="btn btn-primary nav-cta">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
      </svg>
      <span>Pedir Presupuesto</span>
    </a>
  </div>
</header>

<style>
  /* — Barra superior — */
  .topbar {
    background: var(--brand-ink);
    color: var(--on-dark-muted);
    font-size: var(--fs-50);
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 38px;
  }
  .topbar-lead {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .topbar-lead svg { color: var(--accent); }
  .topbar-list {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .topbar-list a { color: var(--on-dark); font-weight: 500; }
  .topbar-list a:hover { color: var(--accent); }
  .topbar-sep { width: 1px; height: 13px; background: rgba(245, 241, 236, 0.22); }
  .topbar-hours {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 500;
  }
  @media (max-width: 860px) {
    .topbar-lead { font-size: 0.625rem; }
  }
  @media (max-width: 620px) {
    .topbar-sep, .topbar-hours { display: none; }
  }

  /* — Header principal — */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    transition: box-shadow var(--t-base);
  }
  .site-header.is-scrolled { box-shadow: var(--shadow-md); }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 74px;
  }
  .brand { flex-shrink: 0; text-decoration: none; }
  .site-nav { flex: 0 1 auto; }
  .site-nav > ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 1.75rem;
  }
  .nav-cta { flex-shrink: 0; }

  .nav-link {
    position: relative;
    display: inline-block;
    padding: 0.4rem 0;
    white-space: nowrap;
    color: var(--text);
    font-weight: 500;
    font-size: var(--fs-100);
  }
  .nav-link:hover { color: var(--brand-rust); }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: 0;
    height: 2px;
    background: var(--accent);
    transition: width var(--t-base), left var(--t-base);
  }
  .nav-link:hover::after,
  .nav-link.is-active::after { width: 100%; left: 0; }
  .nav-link.is-active { color: var(--brand-rust); font-weight: 600; }

  .nav-toggle {
    display: none;
    background: transparent;
    border: 0;
    padding: var(--space-2);
    cursor: pointer;
  }
  .nav-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--brand-ink);
    margin: 5px 0;
    transition: transform var(--t-base), opacity var(--t-base);
  }
  .nav-toggle[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 1100px) {
    .site-nav > ul { gap: 1.15rem; }
    .nav-link { font-size: var(--fs-50); }
  }

  @media (max-width: 960px) {
    .header-inner { gap: var(--space-3); }
    .nav-toggle { display: block; order: 3; }
    .site-nav {
      order: 4;
      flex-basis: 100%;
      background: var(--surface);
      border-top: 1px solid var(--line);
      padding: var(--space-2) 0 var(--space-4);
      display: none;
    }
    .site-nav.is-open { display: block; }
    .site-nav > ul { flex-direction: column; gap: 0; }
    .site-nav li { border-bottom: 1px solid var(--line); }
    .site-nav .nav-link {
      display: block;
      padding: var(--space-3) 0;
      font-size: var(--fs-200);
    }
    .site-nav .nav-link::after { display: none; }
    .nav-cta { order: 2; font-size: var(--fs-50); padding: 0.6rem 0.9rem; }
  }
  @media (max-width: 480px) {
    .nav-cta span { display: none; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-site-nav]');

  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  });

  document.querySelector('[data-site-header]')?.classList.add('is-scrolled');
</script>
